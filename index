<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Burkley Creative Group, LLC</title>

  <meta
    name="description"
    content="Burkley Creative Group, LLC provides photography, media, design, documentation, and practical operational support for agencies, businesses, events, and public service teams."
  />

  <style>
    :root {
      --navy: #071a33;
      --navy-deep: #03101f;
      --blue: #123a66;
      --blue-soft: #1a4778;
      --orange: #c76c2d;
      --orange-light: #f09b54;
      --cream: #f6efe6;
      --paper: #fffaf2;
      --white: #ffffff;
      --ink: #121924;
      --muted: #6a7280;
      --line: rgba(7, 26, 51, 0.12);
      --glass: rgba(255, 255, 255, 0.1);
      --shadow: 0 30px 90px rgba(7, 26, 51, 0.24);
      --soft-shadow: 0 18px 52px rgba(7, 26, 51, 0.12);
      --radius: 30px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: var(--ink);
      background: var(--cream);
      line-height: 1.6;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .page {
      min-height: 100vh;
      background:
        radial-gradient(circle at 12% 10%, rgba(199, 108, 45, 0.16), transparent 28%),
        radial-gradient(circle at 90% 18%, rgba(18, 58, 102, 0.16), transparent 30%),
        linear-gradient(180deg, #fff8ef 0%, #f6efe6 48%, #fffaf2 100%);
    }

    .header {
      position: fixed;
      top: 18px;
      left: 50%;
      z-index: 1000;
      width: min(1180px, calc(100% - 32px));
      transform: translateX(-50%);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 999px;
      background: rgba(7, 26, 51, 0.9);
      box-shadow: 0 20px 70px rgba(0, 0, 0, 0.25);
      backdrop-filter: blur(18px);
    }

    .nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      padding: 12px 14px 12px 18px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--white);
      font-weight: 950;
      letter-spacing: 0.045em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .brand-mark {
      width: 58px;
      height: 58px;
      border-radius: 18px;
      display: grid;
      place-items: center;
      background: rgba(255, 250, 242, 0.96);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.24);
      overflow: hidden;
    }

    .brand-logo {
      width: 48px;
      height: auto;
      display: block;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
      color: rgba(255, 255, 255, 0.76);
      font-size: 0.92rem;
      font-weight: 800;
    }

    .mobile-menu {
      display: none;
      position: relative;
    }

    .menu-toggle {
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.08);
      color: var(--white);
      padding: 10px 14px;
      border-radius: 14px;
      font-size: 1.2rem;
      cursor: pointer;
    }

    .mobile-dropdown {
      position: absolute;
      top: 58px;
      right: 0;
      min-width: 220px;
      padding: 10px;
      border-radius: 20px;
      background: rgba(7, 26, 51, 0.96);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
      display: none;
      flex-direction: column;
      gap: 6px;
    }

    .mobile-dropdown a {
      color: var(--white);
      padding: 12px 14px;
      border-radius: 12px;
      font-weight: 800;
    }

    .mobile-dropdown a:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    .mobile-menu:hover .mobile-dropdown {
      display: flex;
    }

    .nav-links a {
      padding: 10px 14px;
      border-radius: 999px;
      transition: 0.2s ease;
    }

    .nav-links a:hover {
      color: var(--white);
      background: rgba(255, 255, 255, 0.1);
    }

    .nav-links .nav-button {
      color: var(--white);
      background: var(--orange);
      box-shadow: 0 12px 28px rgba(199, 108, 45, 0.32);
    }

    .hero {
      position: relative;
      min-height: 100vh;
      padding: 108px 24px 82px;
      color: var(--white);
      overflow: hidden;
      background:
        linear-gradient(112deg, rgba(7, 26, 51, 0.98), rgba(7, 26, 51, 0.82) 54%, rgba(7, 26, 51, 0.96)),
        radial-gradient(circle at 78% 26%, rgba(240, 155, 84, 0.33), transparent 30%),
        linear-gradient(135deg, var(--navy), var(--blue-soft));
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      opacity: 0.16;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
      background-size: 70px 70px;
      mask-image: radial-gradient(circle at center, black 0%, transparent 72%);
    }

    .hero::after {
      content: "BCG";
      position: absolute;
      right: -3vw;
      bottom: -7vw;
      font-size: clamp(11rem, 28vw, 30rem);
      font-weight: 950;
      letter-spacing: -0.13em;
      color: rgba(255, 255, 255, 0.035);
      line-height: 0.8;
    }

    .hero-inner {
      position: relative;
      z-index: 1;
      width: min(1180px, 100%);
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.95fr);
      gap: 54px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: var(--orange-light);
      font-size: 0.78rem;
      font-weight: 950;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .hero h1 {
      max-width: 720px;
      font-size: clamp(1.8rem, 3.9vw, 3.7rem);
      line-height: 0.92;
      letter-spacing: -0.08em;
      margin-bottom: 28px;
    }

    .hero-copy p {
      max-width: 700px;
      color: rgba(255, 255, 255, 0.82);
      font-size: clamp(1.05rem, 1.7vw, 1.28rem);
      margin-bottom: 34px;
    }

    @media (max-width: 760px) {
      .nav-links {
        display: none;
      }

      .mobile-menu {
        display: block;
      }
    }
  </style>
</head>

<body>
  <div class="page">
    <header class="header">
      <nav class="nav" aria-label="Primary navigation">

        <a class="brand" href="#top" aria-label="Burkley Creative Group home">
          <span class="brand-mark">
            <img
              class="brand-logo"
              src="images/logo/bcg-logo.png"
              alt="Burkley Creative Group logo"
            >
          </span>

          <span>Burkley Creative Group</span>
        </a>

        <div class="nav-links">
          <a href="#services">Services</a>
          <a href="#about">About</a>
          <a href="#work">Work</a>
          <a href="#process">Process</a>
          <a class="nav-button" href="#contact">Start a Project</a>
        </div>

        <div class="mobile-menu">
          <button class="menu-toggle" aria-label="Open menu">☰</button>

          <div class="mobile-dropdown">
            <a href="#services">Services</a>
            <a href="#about">About</a>
            <a href="#work">Work</a>
            <a href="#process">Process</a>
            <a href="#contact">Contact</a>
          </div>
        </div>

      </nav>
    </header>
  </div>
</body>
</html>
